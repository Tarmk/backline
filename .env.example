# --- Local development ---
# Leave DATABASE_URL empty to use the built-in PGlite database (stored in .data/).
DATABASE_URL=

# Set to 1 only if you serve the app over plain http in production (e.g. testing on a LAN IP).
INSECURE_COOKIES=

# --- docker compose (server) ---
# Your domain, already pointing at the server. Caddy gets an HTTPS certificate for it.
DOMAIN=backline.example.com
# Pick a long random password.
POSTGRES_PASSWORD=
